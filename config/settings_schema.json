[
  {
    "name": "theme_info",
    "theme_name": "Styled by Gloria",
    "theme_version": "1.0.0",
    "theme_author": "Antigravity",
    "theme_documentation_url": "https://styledbygloria.com",
    "theme_support_url": "https://styledbygloria.com"
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram Link",
        "default": "https://instagram.com/styledbygloria_g"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok Link",
        "default": "https://tiktok.com/@styledbygloria_g"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube Link",
        "default": "https://youtube.com"
      }
    ]
  },
  {
    "name": "Lead Capture",
    "settings": [
      {
        "type": "url",
        "id": "lead_endpoint",
        "label": "Cloudflare Worker endpoint",
        "info": "Enter the deployed Worker URL, for example https://leads.yourdomain.com"
      }
    ]
  },
  {
    "name": "Storewide promotion",
    "settings": [
      {
        "type": "checkbox",
        "id": "sbg_promo_enabled",
        "label": "Show storewide promotion",
        "default": true
      },
      {
        "type": "range",
        "id": "sbg_promo_percent",
        "label": "Discount percentage",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 25
      },
      {
        "type": "text",
        "id": "sbg_promo_code",
        "label": "Shopify discount code",
        "info": "Enter the exact code created in Shopify. It is applied when the customer goes to checkout."
      }
    ]
  }
]
