{%- comment -%}
  SBG Sticky top announcement bar for announcements and promotions
{%- endcomment -%}

{%- if section.settings.show_announcement -%}
  {%- liquid
    assign announcement_text = section.settings.text
    if settings.sbg_promo_enabled
      assign announcement_text = settings.sbg_promo_percent | default: 25 | append: '% OFF SITEWIDE — USE CODE ' | append: settings.sbg_promo_code | append: ' AT CHECKOUT'
    endif
  -%}
  <style type="text/css">
    #SBG-AnnouncementBar {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      font-size: {{ section.settings.font_size }}px;
      letter-spacing: 0.25em;
      transition: transform 0.35s ease;
    }
    .announcement-bar-close {
      color: inherit;
      opacity: 0.7;
      transition: opacity 0.2s ease;
    }
    .announcement-bar-close:hover {
      opacity: 1;
    }
  </style>

  <div id="SBG-AnnouncementBar" class="{% if section.settings.sticky %}fixed top-0 left-0{% else %}relative{% endif %} w-full z-50 flex items-center justify-between px-6 py-2.5 font-body uppercase select-none text-center">
    <div class="flex-1 flex justify-center items-center">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="hover:underline transition duration-300">
          {{ announcement_text }}
        </a>
      {%- else -%}
        <span>{{ announcement_text }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.show_close_button -%}
      <button onclick="closeAnnouncementBar()" class="announcement-bar-close p-1 focus:outline-none cursor-pointer absolute right-4 top-1/2 -translate-y-1/2" aria-label="{{ 'general.accessibility.close_announcement' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    {%- endif -%}
  </div>
  {%- if section.settings.sticky -%}
    <div id="SBG-AnnouncementSpacer" aria-hidden="true"></div>
  {%- endif -%}

  <script>
    function closeAnnouncementBar() {
      const bar = document.getElementById('SBG-AnnouncementBar');
      if (bar) {
        bar.style.display = 'none';
        // Adjust fixed header offset if needed
        const header = document.getElementById('SBG-Header');
        if (header) {
          header.style.top = '0';
        }
        const spacer = document.getElementById('SBG-AnnouncementSpacer');
        if (spacer) spacer.style.height = '0';
      }
    }

    // The header is fixed, so it must always begin below a visible announcement bar.
    function positionHeaderBelowAnnouncement() {
      const bar = document.getElementById('SBG-AnnouncementBar');
      const header = document.getElementById('SBG-Header');
      const spacer = document.getElementById('SBG-AnnouncementSpacer');
      if (bar && header && bar.style.display !== 'none') {
        header.style.top = bar.offsetHeight + 'px';
        if (spacer) spacer.style.height = bar.offsetHeight + 'px';
      }
    }

    document.addEventListener('DOMContentLoaded', positionHeaderBelowAnnouncement);
    window.addEventListener('resize', positionHeaderBelowAnnouncement);
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SBG Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky Top Position",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "25% OFF SITEWIDE — USE CODE SBG25 AT CHECKOUT"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link Url"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 8,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show Close Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "SBG Announcement Bar"
    }
  ]
}
{% endschema %}
