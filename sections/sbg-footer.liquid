{%- comment -%}
  SBG Editorial Grid Footer with collapsible mobile accordions
{%- endcomment -%}

<style type="text/css">
  .footer-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
    opacity: 0;
  }
  .footer-accordion-content.open {
    max-height: 500px;
    opacity: 1;
  }
  .footer-chevron {
    transition: transform 0.3s ease-out;
  }
  .footer-chevron.open {
    transform: rotate(180deg);
  }
  @media (min-width: 768px) {
    .footer-accordion-content {
      max-height: 500px;
      opacity: 1;
      overflow: visible;
    }
  }
</style>

<footer class="bg-sbg-black border-t border-white/10 w-full overflow-hidden select-none font-body">
  {%- assign instagram_url = settings.social_instagram_link | default: 'https://instagram.com/styledbygloria_g' -%}
  {%- assign tiktok_url = settings.social_tiktok_link | default: 'https://tiktok.com/@styledbygloria_g' -%}
  {%- assign youtube_url = settings.social_youtube_link | default: 'https://youtube.com/@styledbygloria_g' -%}
  <!-- 5-Column Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-white/10 border-b border-white/10 w-full">

    <!-- Column 1: Brand & Contact Coordinates -->
    <div class="col-span-1 md:col-span-3 p-6 md:p-8 flex flex-col space-y-6">
      <!-- Mobile Accordion Header -->
      <button onclick="toggleFooterAccordion('footer-brand', 'chevron-brand')" class="w-full flex items-center justify-between text-left md:hidden" aria-expanded="false">
        <h2 class="font-display text-xl font-bold tracking-[0.18em] uppercase text-sbg-white">
          {{ section.settings.brand_title | default: shop.name }}
        </h2>
        <svg id="chevron-brand" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-chevron h-4 w-4 text-sbg-white/70"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <!-- Desktop Static Header -->
      <div class="hidden md:block">
        <h2 class="font-display text-xl md:text-3xl font-bold tracking-[0.2em] uppercase text-sbg-white mb-4">
          {{ section.settings.brand_title | default: shop.name }}
        </h2>
      </div>

      <!-- Mobile Collapsible Content -->
      <div id="footer-brand" class="footer-accordion-content md:hidden space-y-6">
        <div class="space-y-2 pb-2">
          <p class="font-body text-[9px] font-bold tracking-[0.2em] uppercase text-sbg-white/50">
            {{ 'general.social.follow_us' | t }}
          </p>
          <div class="flex space-x-4">
            {%- if section.settings.email_address != blank -%}
              <a href="mailto:{{ section.settings.email_address }}" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="{{ 'general.accessibility.email_office' | t }}">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M3 4c-1.11 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.11-.9-2-2-2H3zm18 4.75L12 14.12 3 8.75V6l9 5.38L21 6v2.75z"/></svg>
              </a>
            {%- endif -%}
            <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg></a>
            <a href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M15.5 3h3.1c.3 1.7 1.3 3 2.9 3.7v3.2c-1.1-.1-2.1-.4-3-.9v6.1c0 3.6-2.5 5.9-6 5.9-3.2 0-5.5-2.1-5.5-5.1 0-3.2 2.6-5.4 6.1-5.4.4 0 .8 0 1.1.1v3.2c-.4-.1-.7-.2-1.1-.2-1.5 0-2.6.9-2.6 2.2 0 1.1.8 1.9 2 1.9 1.4 0 2.4-1 2.4-2.8V3z"/></svg></a>
            <a href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg></a>
          </div>
        </div>
      </div>

      <!-- Desktop Static Footer actions -->
      <div class="hidden md:block mt-4 space-y-2">
        <p class="font-body text-[10px] font-bold tracking-[0.2em] uppercase text-sbg-white/50">
          {{ 'general.social.follow_us' | t }}
        </p>
        <div class="flex space-x-4">
          {%- if section.settings.email_address != blank -%}
            <a href="mailto:{{ section.settings.email_address }}" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="Email Office">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M3 4c-1.11 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.11-.9-2-2-2H3zm18 4.75L12 14.12 3 8.75V6l9 5.38L21 6v2.75z"/></svg>
            </a>
          {%- endif -%}
          <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg></a>
          <a href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M15.5 3h3.1c.3 1.7 1.3 3 2.9 3.7v3.2c-1.1-.1-2.1-.4-3-.9v6.1c0 3.6-2.5 5.9-6 5.9-3.2 0-5.5-2.1-5.5-5.1 0-3.2 2.6-5.4 6.1-5.4.4 0 .8 0 1.1.1v3.2c-.4-.1-.7-.2-1.1-.2-1.5 0-2.6.9-2.6 2.2 0 1.1.8 1.9 2 1.9 1.4 0 2.4-1 2.4-2.8V3z"/></svg></a>
          <a href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer" class="text-sbg-white hover:opacity-80 transition-opacity" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg></a>
        </div>
      </div>
    </div>

    <!-- Column 2: 01/ Menu 1 links -->
    <div class="col-span-1 md:col-span-2 p-6 md:p-8 flex flex-col md:space-y-4">
      <button onclick="toggleFooterAccordion('footer-menu1', 'chevron-menu1')" class="w-full flex items-center justify-between text-left md:hidden">
        <span class="font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
          01/ {{ section.settings.menu1_title | default: 'Navigation' }}
        </span>
        <svg id="chevron-menu1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-chevron h-4 w-4 text-sbg-white/70"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <span class="hidden md:inline font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
        01/ {{ section.settings.menu1_title | default: 'Navigation' }}
      </span>

      <div id="footer-menu1" class="footer-accordion-content md:block">
        <ul class="font-body space-y-3 text-[11px] font-normal tracking-[0.12em] pb-2 pt-2 md:pt-0">
          <li><a href="/pages/about" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Styled by Gloria</a></li>
          <li><a href="/pages/contact" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Contact</a></li>
          <li><a href="/pages/services" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Services</a></li>
          <li><a href="/pages/brand" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">The Brand</a></li>
        </ul>
      </div>
    </div>

    <!-- Column 3: 02/ Menu 2 links -->
    <div class="col-span-1 md:col-span-2 p-6 md:p-8 flex flex-col md:space-y-4">
      <button onclick="toggleFooterAccordion('footer-menu2', 'chevron-menu2')" class="w-full flex items-center justify-between text-left md:hidden">
        <span class="font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
          02/ {{ section.settings.menu2_title | default: 'Support' }}
        </span>
        <svg id="chevron-menu2" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-chevron h-4 w-4 text-sbg-white/70"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <span class="hidden md:inline font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
        02/ {{ section.settings.menu2_title | default: 'Support' }}
      </span>

      <div id="footer-menu2" class="footer-accordion-content md:block">
        <ul class="font-body space-y-3 text-[11px] font-normal tracking-[0.12em] pb-2 pt-2 md:pt-0">
          <li><a href="/pages/shipping-policy" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Shipping Policy</a></li>
          <li><a href="/pages/return-exchange" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Return & Exchange</a></li>
          <li><a href="/pages/privacy-policy" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Privacy Policy</a></li>
          <li><a href="/pages/care-instructions" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">Care Instructions</a></li>
        </ul>
      </div>
    </div>

    <!-- Column 4: 03/ Menu 3 links -->
    <div class="col-span-1 md:col-span-2 p-6 md:p-8 flex flex-col md:space-y-4">
      <button onclick="toggleFooterAccordion('footer-menu3', 'chevron-menu3')" class="w-full flex items-center justify-between text-left md:hidden">
        <span class="font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
          03/ {{ section.settings.menu3_title | default: 'Popular Now' }}
        </span>
        <svg id="chevron-menu3" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-chevron h-4 w-4 text-sbg-white/70"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <span class="hidden md:inline font-body text-[10px] tracking-[0.18em] font-bold text-sbg-white/80">
        03/ {{ section.settings.menu3_title | default: 'Popular Now' }}
      </span>

      <div id="footer-menu3" class="footer-accordion-content md:block">
        <ul class="font-body space-y-3 text-[11px] font-normal tracking-[0.12em] pb-2 pt-2 md:pt-0">
          <li><a href="{{ routes.all_products_collection_url }}" class="text-sbg-white/70 hover:text-white hover:underline underline-offset-4">One for All</a></li>
        </ul>
      </div>
    </div>

    <!-- Column 5: Newsletter Promotion & Reach Out Actions -->
    <div class="col-span-1 md:col-span-3 p-6 md:p-8 flex flex-col space-y-6">
      <button onclick="toggleFooterAccordion('footer-newsletter', 'chevron-newsletter')" class="w-full flex items-center justify-between text-left md:hidden">
        <h3 class="font-display text-lg font-bold tracking-[0.15em] uppercase text-sbg-white leading-tight">
          REACH OUT
        </h3>
        <svg id="chevron-newsletter" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-chevron h-4 w-4 text-sbg-white/70"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <div class="hidden md:block">
        <h3 class="font-display text-base md:text-lg font-bold tracking-[0.15em] uppercase text-sbg-white leading-tight">
          REACH OUT
        </h3>
      </div>

      <div id="footer-newsletter" class="footer-accordion-content md:block pt-2 w-full text-left">
        <p class="text-[10px] tracking-[0.16em] leading-relaxed uppercase text-sbg-white/70 mb-4">
          Sign up for our newsletter and offers
        </p>
        {%- form 'customer', id: 'FooterNewsletterForm', class: 'space-y-3 mb-6 w-full' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="text-[10px] tracking-wider text-sbg-white/80">Thanks for signing up.</p>
          {%- else -%}
            <div class="flex w-full flex-col justify-start sm:flex-row gap-2">
              <label class="sr-only" for="FooterNewsletterEmail">Email address</label>
              <input id="FooterNewsletterEmail" type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email" placeholder="Your email address" class="min-w-0 flex-1 border border-white/30 bg-transparent px-3 py-3 text-[10px] tracking-wider text-sbg-white placeholder:text-sbg-white/50 focus:border-sbg-white focus:outline-none">
              <button type="submit" class="border border-sbg-white bg-sbg-white px-4 py-3 text-[10px] font-bold tracking-widest text-sbg-black transition-colors hover:bg-transparent hover:text-sbg-white">SIGN UP</button>
            </div>
            {%- if form.errors -%}
              <p class="text-[10px] tracking-wider text-red-200">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

      </div>
    </div>

  </div>

  <!-- Bottom Copyright Bar -->
  <div class="py-4 text-center">
    <p class="font-body text-[9px] tracking-widest text-sbg-white/50 uppercase">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. {{ 'general.meta.copyright' | t | upcase }}
    </p>
  </div>
</footer>

<script>
  function toggleFooterAccordion(contentId, chevronId) {
    if (window.innerWidth >= 768) return; // Only run on mobile
    const content = document.getElementById(contentId);
    const chevron = document.getElementById(chevronId);
    if (content.classList.contains('open')) {
      content.classList.remove('open');
      chevron.classList.remove('open');
    } else {
      content.classList.add('open');
      chevron.classList.add('open');
    }
  }
</script>

{% schema %}
{
  "name": "SBG Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "STYLED BY GLORIA"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Contact Email",
      "default": "studio@styledbygloria.com"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Contact Number",
      "default": "+91 00000 00000"
    },
    {
      "type": "link_list",
      "id": "menu1",
      "label": "Menu 1 Linklist"
    },
    {
      "type": "text",
      "id": "menu1_title",
      "label": "Menu 1 Title",
      "default": "Gloria"
    },
    {
      "type": "link_list",
      "id": "menu2",
      "label": "Menu 2 Linklist"
    },
    {
      "type": "text",
      "id": "menu2_title",
      "label": "Menu 2 Title",
      "default": "Customer Service"
    },
    {
      "type": "link_list",
      "id": "menu3",
      "label": "Menu 3 Linklist"
    },
    {
      "type": "text",
      "id": "menu3_title",
      "label": "Menu 3 Title",
      "default": "Popular Now"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Newsletter promo line",
      "default": "REACH OUT"
    }
  ]
}
{% endschema %}
