{%- comment -%}
  SBG Brand Mission section with grid line accents
{%- endcomment -%}

<style type="text/css">
  .sg-mission-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-size: 60px 60px;
    background-image: 
      linear-gradient(to right, rgba(0, 0, 0, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.07) 1px, transparent 1px);
    mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
    -webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
  }
</style>

<section class="bg-sbg-white w-full pt-20 md:pt-32 border-t border-sbg-border flex flex-col justify-between relative overflow-hidden select-none">
  <!-- Fading Background Grid Lines -->
  <div class="sg-mission-grid-bg"></div>
  
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center pb-16 md:pb-24 relative z-10">
    <h2 class="animate-text-words font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-light tracking-wide leading-snug text-sbg-black max-w-4xl mx-auto">
      Helping you love your body more.
    </h2>
  </div>

</section>

{% schema %}
{
  "name": "SBG Mission",
  "settings": [
    {
      "type": "textarea",
      "id": "mission_heading",
      "label": "Mission Heading",
      "default": "You weren't made to fit clothes, clothes were made to fit you."
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "Dressing for your body type starts here. At Styled by Gloria, we design body type intentional clothes made to fit your specific shape, not the compiled average. By creating pieces intentionally designed to flatter your shape, suddenly, clarity begins, disappointment is a distant memory and love for your body increases."
    },
    {
      "type": "textarea",
      "id": "mission_closing",
      "label": "Mission Closing",
      "default": "Because you're finally seeing yourself wear clothes, not letting clothes wear you."
    },
    {
      "type": "textarea",
      "id": "mission_final",
      "label": "Mission Final Line",
      "default": "Love for yourself starts with intentionality, it starts with you."
    },
    {
      "type": "text",
      "id": "sub_label",
      "label": "Sub-label Text",
      "default": "Our Foundational Promise"
    }
  ],
  "presets": [
    {
      "name": "SBG Mission"
    }
  ]
}
{% endschema %}
