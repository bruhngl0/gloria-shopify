{%- comment -%}
  SBG Shop page with screenshot-matched filters and featured product detail.
{%- endcomment -%}

<style type="text/css">
  .shop-filter-button.active {
    border-color: #0A0A0A;
    background-color: #0A0A0A;
    color: #FFFFFF;
    outline: 2px solid #1473E6;
    outline-offset: -1px;
  }
  .shop-filter-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    overflow: visible;
  }
  .shop-filter-row > div {
    flex: 0 0 auto;
  }
  .shop-image-placeholders {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .shop-filter-button {
    font-size: 8px !important;
    line-height: 1.1;
    padding: 0.7rem 0.85rem !important;
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .shop-filter-row {
      flex-direction: column !important;
      align-items: stretch;
      gap: 1.25rem;
    }
    .shop-filter-row > div {
      width: 100%;
    }
    .shop-filter-row .flex {
      gap: 0.4rem;
    }
    .shop-filter-button {
      padding: 0.65rem 0.75rem !important;
    }
  }
</style>

{%- liquid
  assign shop_product = collection.products.first
  assign shop_variant = shop_product.selected_or_first_available_variant
  assign shop_title = shop_product.title | default: 'THE ONE FOR ALL DRESS'
  assign shop_price = shop_product.price | default: 18500
  assign shop_description = "More than elegance and grace, the One for All dress was designed to flatter every body type. It was created to solve a problem most women know too well: falling in love with a dress, only to realize it doesn't look the same on them as it does on the model, even in the right size. It was never your body shape, it was the shape of the dress. This isn't simply a dress that fits. The combination of every cut, shape and proportion was designed to balance and compliment your natural shape. From the refined boat neckline that flatters the upper silhouette, to the softly flared sleeves that add elegance and balance at just the right length. The A-line skirt creates graceful movement while adding subtle volume through the lower half, bringing harmony across all body types. Thoughtfully designed to work with your natural shape, the One for All takes the guesswork out of getting dressed, so you can spend less time questioning your clothes and more time feeling confident in them."
-%}

<section class="bg-sbg-white w-full py-16 md:py-24 border-b border-sbg-border/60 select-none">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Screenshot-matched filter row. These controls submit Shopify-compatible collection filters. -->
    <form action="{{ collection.url }}" method="get" id="shop-filter-form" class="border-t border-b border-sbg-border/60 py-6 mb-16 text-[9px] tracking-widest text-sbg-grey uppercase">
    <div class="shop-filter-row">
      <div class="space-y-3">
        <span class="font-bold block">SHOP BY BODY TYPE</span>
        <div class="flex flex-wrap gap-2">
          {%- assign body_filters = 'ALL BODY TYPES|HOURGLASS|PEAR|RECTANGLE|INVERTED TRIANGLE|APPLE' | split: '|' -%}
          {%- for filter in body_filters -%}
            <button type="submit" name="filter.p.tag" value="{% unless forloop.first %}{{ filter | handleize }}{% endunless %}" class="shop-filter-button border border-sbg-border/60 px-6 py-5 font-semibold hover:border-sbg-black transition-colors {% if forloop.first %}active{% endif %}">{{ filter }}</button>
          {%- endfor -%}
        </div>
      </div>

      <div class="space-y-3">
        <span class="font-bold block">SHOP BY COLOR</span>
        <select name="filter.v.option.color" class="shop-filter-select border border-sbg-border/60 bg-sbg-white px-4 py-3 text-[8px] font-semibold tracking-widest text-sbg-grey uppercase focus:outline-none focus:border-sbg-black" aria-label="Shop by color">
          <option value="">SELECT COLOR</option>
          <option value="light-blue">LIGHT BLUE</option>
        </select>
      </div>
    </div>
    </form>

    <!-- Product image and detail panel -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start reveal-on-scroll">
      <div class="lg:col-span-5 relative group">
        <div class="relative aspect-[3/4] overflow-hidden bg-sbg-offwhite border border-sbg-border">
          <img id="shop-main-image" src="{{ 'buybox-white-front-optimized.jpg' | asset_url }}" alt="{{ shop_title | escape }}" width="1800" height="2700" fetchpriority="high" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]">
          <span class="absolute top-4 left-4 bg-sbg-black text-sbg-white text-[9px] font-bold tracking-widest uppercase px-3 py-2">NEW</span>
        </div>
        <div class="shop-image-placeholders grid grid-cols-4 gap-3 mt-4" aria-label="Product image placeholders">
          <img src="{{ 'buybox-white-front-optimized.jpg' | asset_url }}" alt="{{ shop_title | escape }} front view" width="1800" height="2700" loading="lazy" decoding="async" class="shop-thumbnail aspect-[4/5] w-full object-cover border border-sbg-black cursor-pointer">
          <img src="{{ 'buybox-white-motion-optimized.jpg' | asset_url }}" alt="{{ shop_title | escape }} motion view" width="1800" height="2700" loading="lazy" decoding="async" class="shop-thumbnail aspect-[4/5] w-full object-cover border border-sbg-border/60 cursor-pointer">
          <img src="{{ 'buybox-replacement-1.jpg' | asset_url }}" alt="{{ shop_title | escape }} alternate view" width="1280" height="1920" loading="lazy" decoding="async" class="shop-thumbnail aspect-[4/5] w-full object-cover border border-sbg-border/60 cursor-pointer">
          <img src="{{ 'buybox-replacement-2.jpg' | asset_url }}" alt="{{ shop_title | escape }} alternate view" width="1280" height="1920" loading="lazy" decoding="async" class="shop-thumbnail aspect-[4/5] w-full object-cover border border-sbg-border/60 cursor-pointer">
        </div>
        <div class="pt-8 px-1 space-y-1">
          <h2 class="font-display text-sm font-bold tracking-wide uppercase text-sbg-black">{{ shop_title }}</h2>
          <p class="text-xs font-semibold tracking-wider text-sbg-black/80">{{ shop_price | money }}</p>
        </div>
      </div>

      <div class="shop-detail-panel lg:col-span-5 lg:col-start-7 self-center space-y-8 pt-4 lg:pt-10">
        <div class="space-y-8">
          <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-sbg-grey">STYLE CODE: SBG-D001</span>
          <h2 class="font-display text-3xl md:text-5xl font-medium leading-[0.95] tracking-wide uppercase text-sbg-black">{{ shop_title }}</h2>
          <p class="text-xl font-bold tracking-wider text-sbg-black">{{ shop_price | money }}</p>
        </div>

        <div class="space-y-4">
          <span class="text-xs font-bold tracking-[0.18em] uppercase text-sbg-black">WORKS BEAUTIFULLY FOR</span>
          <div class="flex flex-wrap gap-2">
            {%- assign detail_body_types = 'ALL BODY TYPES|HOURGLASS|PEAR|RECTANGLE|INVERTED TRIANGLE|APPLE' | split: '|' -%}
            {%- for type in detail_body_types -%}
              <button type="button" class="border border-sbg-border/60 px-4 py-2.5 text-[11px] tracking-wider text-sbg-grey uppercase hover:border-sbg-black transition-colors">{{ type }}</button>
            {%- endfor -%}
          </div>
        </div>

        {%- if shop_variant != blank -%}
          {%- assign size_option = blank -%}
          {%- for option in shop_product.options_with_values -%}
            {%- assign option_name = option.name | downcase -%}
            {%- if option_name == 'size' -%}
              {%- assign size_option = option -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign display_sizes = 'XS|S|M|L|XL' | split: '|' -%}
          {%- if size_option != blank -%}
            {%- assign display_sizes = size_option.values -%}
          {%- endif -%}
          <form method="post" action="{{ routes.cart_add_url }}" id="shop-add-to-cart-form" class="pt-4">
            <input type="hidden" name="id" value="{{ shop_variant.id }}">
            <div class="mb-5 space-y-3">
              <label class="block text-xs font-bold tracking-[0.18em] uppercase text-sbg-black" for="shop-size-options">SELECT SIZE</label>
              <div id="shop-size-options" class="flex flex-wrap gap-2" role="group" aria-label="Select size">
                {%- for size in display_sizes -%}
                  {%- assign size_variant = blank -%}
                  {%- for variant in shop_product.variants -%}
                    {%- if size_variant == blank and variant.available and variant.options contains size -%}
                      {%- assign size_variant = variant -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button type="button" class="shop-size-option border border-sbg-border/60 px-5 py-3 text-[11px] font-semibold tracking-wider text-sbg-grey uppercase hover:border-sbg-black transition-colors" data-variant-id="{{ size_variant.id | default: shop_variant.id }}" aria-pressed="false">{{ size }}</button>
                {%- endfor -%}
              </div>
            </div>
            <button type="submit" class="w-full border border-sbg-black bg-sbg-black text-sbg-white px-6 py-4 text-xs font-bold tracking-[0.25em] uppercase hover:bg-sbg-white hover:text-sbg-black transition-colors">ADD TO CART</button>
          </form>
        {%- else -%}
          <button type="button" onclick="window.sbg.openCart()" class="w-full border border-sbg-black bg-sbg-black text-sbg-white px-6 py-4 text-xs font-bold tracking-[0.25em] uppercase">ADD TO CART</button>
        {%- endif -%}

        <div class="border-t border-sbg-border/60 pt-8 space-y-6 text-xs tracking-wider leading-relaxed text-sbg-grey">
          <p>{{ shop_description | strip_html }}</p>
        </div>

        <div class="border-t border-sbg-border/60 text-xs font-bold tracking-wider uppercase text-sbg-black">
          <details class="border-b border-sbg-border/60 py-5"><summary class="cursor-pointer">FABRIC &amp; CARE</summary><p class="pt-4 text-xs font-normal normal-case leading-relaxed text-sbg-grey">Heavyweight stretch crepe. Machine wash cold on gentle cycle and lay flat to dry.</p></details>
          <details class="border-b border-sbg-border/60 py-5"><summary class="cursor-pointer">SHIPPING &amp; RETURNS</summary><p class="pt-4 text-xs font-normal normal-case leading-relaxed text-sbg-grey">Orders are processed and packaged within 1-3 business days. Estimated delivery is 3-8 business days within Canada, 5-10 business days to the United States, and 10-21 business days worldwide, plus any customs time. Shipping is calculated at checkout, with free standard shipping on orders of $299 CAD or more. Returns or exchanges are accepted within 30 days of delivery; items must be unworn, unwashed, tagged, and in original packaging. Email info@styledbygloria.com with your order number to begin.</p></details>
          <details class="border-b border-sbg-border/60 py-5"><summary class="cursor-pointer">FIT &amp; CONSTRUCTION ADVICE</summary><p class="pt-4 text-xs font-normal normal-case leading-relaxed text-sbg-grey">Fits true to size. Adjustable ruching allows the silhouette to be tailored to your proportions.</p></details>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const shopCartForm = document.getElementById('shop-add-to-cart-form');
  if (shopCartForm) {
    const shopSizeOptions = document.querySelectorAll('.shop-size-option');
    shopSizeOptions.forEach(function(option) {
      option.addEventListener('click', function() {
        const variantInput = shopCartForm.querySelector('input[name="id"]');
        if (!variantInput) return;
        variantInput.value = this.dataset.variantId;
        shopSizeOptions.forEach(function(item) {
          item.classList.remove('border-sbg-black', 'bg-sbg-black', 'text-sbg-white');
          item.classList.add('border-sbg-border/60', 'text-sbg-grey');
          item.setAttribute('aria-pressed', 'false');
        });
        this.classList.add('border-sbg-black', 'bg-sbg-black', 'text-sbg-white');
        this.classList.remove('border-sbg-border/60', 'text-sbg-grey');
        this.setAttribute('aria-pressed', 'true');
      });
    });

    shopCartForm.addEventListener('submit', function(event) {
      event.preventDefault();
      const submitButton = shopCartForm.querySelector('button[type="submit"]');
      const originalLabel = submitButton.textContent;
      submitButton.disabled = true;
      submitButton.textContent = 'ADDING...';

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: shopCartForm.querySelector('input[name="id"]').value,
            quantity: 1
          }]
        })
      })
        .then(function(response) {
          if (!response.ok) throw new Error('Unable to add item to cart');
          return response.json();
        })
        .then(function() {
          submitButton.textContent = 'ADDED TO CART';
          window.sbg.openCart();
        })
        .catch(function(error) {
          console.error(error);
          submitButton.textContent = 'TRY AGAIN';
        })
        .finally(function() {
          setTimeout(function() {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }, 1600);
        });
    });
  }

  const shopMainImage = document.getElementById('shop-main-image');
  document.querySelectorAll('.shop-thumbnail').forEach(function(thumbnail) {
    thumbnail.addEventListener('click', function() {
      if (!shopMainImage) return;
      shopMainImage.src = this.src;
      shopMainImage.alt = this.alt;
      document.querySelectorAll('.shop-thumbnail').forEach(function(item) {
        item.classList.remove('border-sbg-black');
        item.classList.add('border-sbg-border/60');
      });
      this.classList.remove('border-sbg-border/60');
      this.classList.add('border-sbg-black');
    });
  });

  const shopFilterForm = document.getElementById('shop-filter-form');
  if (shopFilterForm) {
    shopFilterForm.querySelectorAll('select').forEach(function(select) {
      select.addEventListener('change', function() { shopFilterForm.submit(); });
    });
    const activeTag = new URLSearchParams(window.location.search).get('filter.p.tag');
    shopFilterForm.querySelectorAll('.shop-filter-button').forEach(function(button) {
      button.classList.toggle('active', button.value === activeTag || (!activeTag && button.value === ''));
    });
  }
</script>

{% schema %}
{
  "name": "SBG Shop Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "Products Per Page",
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card Aspect Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show Second Image on Hover",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "SBG Shop Page"
    }
  ]
}
{% endschema %}
