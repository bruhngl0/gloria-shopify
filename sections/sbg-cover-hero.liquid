{%- comment -%}
  SBG full-bleed image hero with centered overlay text.
{%- endcomment -%}

<style type="text/css">
  .hero-animate-center {
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1.4s ease-out, transform 1.4s ease-out;
    will-change: opacity, transform;
  }

  .sbg-loaded .hero-animate-center {
    opacity: 1;
    transform: scale(1);
  }

  .hero-animate-copy,
  .hero-animate-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1.2s ease-out, transform 1.2s ease-out;
    transition-delay: 0.35s;
  }

  .hero-animate-copy {
    position: absolute;
    top: auto !important;
    right: 0;
    bottom: 7rem !important;
    left: 0;
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-animate-copy {
      bottom: 8rem !important;
    }
  }

  .sbg-loaded .hero-animate-copy,
  .sbg-loaded .hero-animate-scroll {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<section class="relative isolate w-full min-h-screen overflow-hidden bg-sbg-white select-none border-b border-sbg-border">
  <!-- Full-bleed hero image -->
  <div class="absolute inset-0">
    <div class="hero-animate-center absolute inset-0">
      <img
        src="{% if section.settings.image_center != blank %}{{ section.settings.image_center | image_url: width: 2400 }}{% else %}{{ 'generated-image-1-3.png' | asset_url }}{% endif %}"
        alt="{{ section.settings.hero_title }}"
        class="hero-cover-image w-full h-full object-cover"
      >
    </div>
  </div>

  <!-- Overlay copy -->
  <div class="hero-animate-copy absolute inset-x-0 bottom-24 z-10 flex items-end justify-start px-6 text-left text-sbg-black md:bottom-28 md:px-[60px] lg:px-[65px]">
    <div class="max-w-none">
      <p class="mb-6 text-xs md:text-sm font-semibold tracking-[0.35em] uppercase text-sbg-black/70">
        {{ section.settings.top_label | default: 'BODY-TYPE INTENTIONAL FASHION' }}
      </p>
      <h1 class="whitespace-nowrap font-display text-5xl md:text-6xl lg:text-7xl font-medium leading-[0.9] tracking-[0.08em] uppercase text-sbg-black">
        {{ section.settings.hero_title | default: 'ONE FOR ALL' }}
      </h1>
      {%- if section.settings.hero_subtitle != blank -%}
        <p class="mt-7 max-w-xl text-sm md:text-base leading-relaxed tracking-[0.16em] uppercase text-sbg-black/75">
          {{ section.settings.hero_subtitle }}
        </p>
      {%- endif -%}
      <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="mt-9 inline-flex border border-sbg-black px-7 py-3 text-[10px] font-bold tracking-[0.25em] uppercase text-sbg-black transition-colors duration-300 hover:bg-sbg-black hover:text-sbg-white">
        {{ section.settings.button_text | default: 'SHOP THE COLLECTION' }}
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div onclick="document.getElementById('sbg-buy-box')?.scrollIntoView({ behavior: 'smooth' })" class="hero-animate-scroll absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 cursor-pointer flex-col items-center space-y-2 text-center text-sbg-black">
    <span class="text-[8.5px] tracking-[0.2em] uppercase text-sbg-black/65">
      {{ 'sections.cover_hero.explore_collection' | t }}
    </span>
    <div class="h-8 w-px bg-sbg-black/60"></div>
  </div>
</section>

{% schema %}
{
  "name": "SBG Cover Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_center",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Eyebrow Text",
      "default": "BODY-TYPE INTENTIONAL FASHION"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "ONE FOR ALL"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "A signature silhouette designed around your proportions."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "SBG Cover Hero"
    }
  ]
}
{% endschema %}
